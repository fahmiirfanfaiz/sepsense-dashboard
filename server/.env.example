# Copy this file to `.env` and replace the placeholders with real values.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
FRONTEND_URL="http://localhost:3000"

# ===== Authentication =====
# Generate a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_ISSUER="sepsense-api"
JWT_AUDIENCE="sepsense-client"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="7"

# Set COOKIE_SECURE=true in production (HTTPS).
COOKIE_SECURE="false"
# Use "none" only when the frontend and API are on different sites,
# and make sure COOKIE_SECURE=true in that case.
COOKIE_SAME_SITE="lax"
TRUST_PROXY="1"
